{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gestão da Barbearia",
  "version": "0.2.1",
  "identifier": "com.yuric9.barbershopdesktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gestão da Barbearia",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "windows": { "wix": null, "nsis": null }
  }
}
